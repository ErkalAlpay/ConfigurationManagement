@page
@model Configuration.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Configuration Management";
}

<div class="row">
    <div class="col-12">
        <h2>Configuration Records</h2>
        
        <div class="filter-section">
            <div class="row mb-3">
                <div class="col-md-4">
                    <label for="applicationName" class="form-label">Application Name</label>
                    <input type="text" class="form-control" id="applicationName" value="SERVICE-A" placeholder="Enter application name">
                </div>
                <div class="col-md-4">
                    <label for="apiBaseUrl" class="form-label">API Base URL</label>
                    <input type="text" class="form-control" id="apiBaseUrl" value="@Model.ApiBaseUrl" placeholder="API URL">
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button class="btn btn-primary" onclick="loadConfigurations()">Load Configurations</button>
                    <button class="btn btn-success ms-2" data-bs-toggle="modal" data-bs-target="#addModal">Add New</button>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label for="nameFilter" class="form-label">Filter by Name</label>
                    <input type="text" class="form-control" id="nameFilter" placeholder="Type to filter..." onkeyup="filterTable()">
                </div>
            </div>
        </div>

        <div id="loading" class="text-center" style="display: none;">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>

        <div id="errorMessage" class="alert alert-danger" style="display: none;"></div>

        <table class="table table-striped table-hover" id="configTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Value</th>
                    <th>Is Active</th>
                    <th>Application Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="configTableBody">
                <tr>
                    <td colspan="7" class="text-center">Click "Load Configurations" to load data</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Configuration</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addForm">
                    <div class="mb-3">
                        <label for="addName" class="form-label">Name *</label>
                        <input type="text" class="form-control" id="addName" required>
                    </div>
                    <div class="mb-3">
                        <label for="addType" class="form-label">Type *</label>
                        <select class="form-select" id="addType" required>
                            <option value="string">string</option>
                            <option value="bool">bool</option>
                            <option value="int">int</option>
                            <option value="double">double</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="addValue" class="form-label">Value *</label>
                        <input type="text" class="form-control" id="addValue" required>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="addIsActive" checked>
                            <label class="form-check-label" for="addIsActive">Is Active</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="addConfiguration()">Add</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Configuration</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <input type="hidden" id="editKey">
                    <div class="mb-3">
                        <label for="editValue" class="form-label">Value *</label>
                        <input type="text" class="form-control" id="editValue" required>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="editIsActive">
                            <label class="form-check-label" for="editIsActive">Is Active</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="updateConfiguration()">Update</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let allConfigurations = [];

        function getApiBaseUrl() {
            return document.getElementById('apiBaseUrl').value || '@Model.ApiBaseUrl';
        }

        function getApplicationName() {
            return document.getElementById('applicationName').value || 'SERVICE-A';
        }

        async function loadConfigurations() {
            const loading = document.getElementById('loading');
            const errorMessage = document.getElementById('errorMessage');
            const tableBody = document.getElementById('configTableBody');
            
            loading.style.display = 'block';
            errorMessage.style.display = 'none';
            tableBody.innerHTML = '<tr><td colspan="7" class="text-center">Loading...</td></tr>';

            try {
                const apiUrl = getApiBaseUrl();
                const appName = getApplicationName();
                
                const response = await fetch(`${apiUrl}/api/configuration`, {
                    headers: {
                        'Application-Name': appName
                    }
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                allConfigurations = await response.json();
                renderTable(allConfigurations);
            } catch (error) {
                errorMessage.textContent = `Error loading configurations: ${error.message}`;
                errorMessage.style.display = 'block';
                tableBody.innerHTML = '<tr><td colspan="7" class="text-center text-danger">Error loading data</td></tr>';
            } finally {
                loading.style.display = 'none';
            }
        }

        function renderTable(configurations) {
            const tableBody = document.getElementById('configTableBody');
            
            if (configurations.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="7" class="text-center">No configurations found</td></tr>';
                return;
            }

            tableBody.innerHTML = configurations.map(config => `
                <tr>
                    <td>${config.id || '-'}</td>
                    <td>${escapeHtml(config.name)}</td>
                    <td><span class="badge bg-info">${escapeHtml(config.type)}</span></td>
                    <td>${escapeHtml(config.value)}</td>
                    <td>${config.isActive ? '<span class="badge bg-success status-badge">Active</span>' : '<span class="badge bg-secondary status-badge">Inactive</span>'}</td>
                    <td>${escapeHtml(config.applicationName)}</td>
                    <td>
                        <button class="btn btn-sm btn-warning" onclick="openEditModal('${escapeHtml(config.name)}', '${escapeHtml(config.value)}', ${config.isActive})">Edit</button>
                        <button class="btn btn-sm btn-danger" onclick="deleteConfiguration('${escapeHtml(config.name)}')">Delete</button>
                    </td>
                </tr>
            `).join('');
        }

        function filterTable() {
            const filterValue = document.getElementById('nameFilter').value.toLowerCase();
            const filtered = allConfigurations.filter(config => 
                config.name.toLowerCase().includes(filterValue)
            );
            renderTable(filtered);
        }

        function openEditModal(name, value, isActive) {
            document.getElementById('editKey').value = name;
            document.getElementById('editValue').value = value;
            document.getElementById('editIsActive').checked = isActive;
            new bootstrap.Modal(document.getElementById('editModal')).show();
        }

        async function addConfiguration() {
            const name = document.getElementById('addName').value;
            const type = document.getElementById('addType').value;
            const value = document.getElementById('addValue').value;
            const isActive = document.getElementById('addIsActive').checked;
            const appName = getApplicationName();
            const apiUrl = getApiBaseUrl();

            try {
                const response = await fetch(`${apiUrl}/api/configuration`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Application-Name': appName
                    },
                    body: JSON.stringify({ name, type, value, isActive })
                });

                if (!response.ok) {
                    const error = await response.json();
                    throw new Error(error.message || 'Failed to add configuration');
                }

                bootstrap.Modal.getInstance(document.getElementById('addModal')).hide();
                document.getElementById('addForm').reset();
                loadConfigurations();
            } catch (error) {
                alert(`Error: ${error.message}`);
            }
        }

        async function updateConfiguration() {
            const key = document.getElementById('editKey').value;
            const value = document.getElementById('editValue').value;
            const isActive = document.getElementById('editIsActive').checked;
            const appName = getApplicationName();
            const apiUrl = getApiBaseUrl();

            try {
                const response = await fetch(`${apiUrl}/api/configuration/${encodeURIComponent(key)}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Application-Name': appName
                    },
                    body: JSON.stringify({ value, isActive })
                });

                if (!response.ok) {
                    const error = await response.json();
                    throw new Error(error.message || 'Failed to update configuration');
                }

                bootstrap.Modal.getInstance(document.getElementById('editModal')).hide();
                loadConfigurations();
            } catch (error) {
                alert(`Error: ${error.message}`);
            }
        }

        async function deleteConfiguration(key) {
            if (!confirm(`Are you sure you want to delete configuration "${key}"?`)) {
                return;
            }

            const appName = getApplicationName();
            const apiUrl = getApiBaseUrl();

            try {
                const response = await fetch(`${apiUrl}/api/configuration/${encodeURIComponent(key)}`, {
                    method: 'DELETE',
                    headers: {
                        'Application-Name': appName
                    }
                });

                if (!response.ok) {
                    const error = await response.json();
                    throw new Error(error.message || 'Failed to delete configuration');
                }

                loadConfigurations();
            } catch (error) {
                alert(`Error: ${error.message}`);
            }
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
}

